<Window x:Class="DynamicIslandDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:DynamicIslandDesktop.Helpers"
        Title="Dynamic Island" 
        Height="260" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <helpers:BytesToImageConverter x:Key="BytesToImage"/>
        <!-- Teks compact: saat mode lirik, membungkus ke baris berikutnya (maks 3 baris) -->
        <Style x:Key="CompactTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="MaxHeight" Value="{Binding CompactLyricMaxHeight}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ikon lingkaran-chevron (dari SVG viewBox 0 0 20 20) -->
        <StreamGeometry x:Key="ChevronCircleIcon">F1 M10,17 A7,7 0 1 1 10,3 A7,7 0 0 1 10,17 Z M2,10 A8,8 0 1 0 18,10 A8,8 0 0 0 2,10 Z M8.15,13.15 A0.5,0.5 0 0 0 8.85,13.85 L12.35,10.35 A0.5,0.5 0 0 0 12.35,9.65 L8.85,6.15 A0.5,0.5 0 1 0 8.15,6.85 L11.29,10 L8.15,13.15 Z</StreamGeometry>
        <StreamGeometry x:Key="CloseCircleIcon">F1 M10,17 A7,7 0 1 1 10,3 A7,7 0 0 1 10,17 Z M2,10 A8,8 0 1 0 18,10 A8,8 0 0 0 2,10 Z M7.354,6.646 L13.354,12.646 L12.646,13.354 L6.646,7.354 Z M12.646,6.646 L13.354,7.354 L7.354,13.354 L6.646,12.646 Z</StreamGeometry>

        <!-- Style tombol ikon: tanpa kotak/border, hanya ikon hijau -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1DB954"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" Padding="6"
                            RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol lirik: redup saat nonaktif, terang saat mode lirik aktif -->
        <Style x:Key="LyricsButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Judul & artis: tampil saat mode lirik mati -->
        <Style x:Key="InfoPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Lirik: tampil saat mode lirik aktif -->
        <Style x:Key="LyricsPanelStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Island Container -->
        <Border x:Name="IslandBorder" 
            Background="#0F0F0F" 
            CornerRadius="25" 
            Height="45" Width="48"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            Margin="0,10,0,0"
            MouseLeave="IslandBorder_MouseLeave">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5" Color="Black"/>
            </Border.Effect>

            <Grid x:Name="MainGrid" Margin="8,4">

                <!-- 1. TAMPILAN COMPACT (SAAT ISLAND KECIL) -->
                <Grid x:Name="CompactView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AlbumContainer" Grid.Column="0" Width="30" Height="30" Background="#222" CornerRadius="15" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IntroScale" ScaleX="0.3" ScaleY="0.3"/>
                        </Border.RenderTransform>
                        <Ellipse x:Name="CompactAlbumArt" Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AlbumArt, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="AlbumRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Border>

                    <!-- Area hover: hanya bagian tengah (judul/lirik) -->
                    <Border x:Name="HoverZone" Grid.Column="1" Background="Transparent"
                        MouseEnter="HoverZone_MouseEnter">
                        <TextBlock x:Name="CompactTitleText" Style="{StaticResource CompactTextStyle}"
                           Text="{Binding CompactText}" Opacity="0"
                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                           helpers:TextFit.MaxFontSize="{Binding CompactFontSize}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="8,0"/>
                    </Border>

                    <!-- Ikon menu: bisa diklik, memunculkan pill "Setting" dan "Keluar" -->
                    <Border x:Name="MenuIconButton" Grid.Column="2" Background="Transparent"
                        Cursor="Hand" Padding="4,0"
                        MouseLeftButtonDown="MenuIcon_Click">
                        <Path x:Name="CompactMenuIcon" Data="{StaticResource ChevronCircleIcon}"
                            Width="18" Height="18" Stretch="Uniform"
                            Opacity="0" VerticalAlignment="Center" Margin="0,0,4,0"
                            RenderTransformOrigin="0.5,0.5">
                            <Path.Fill>
                                <SolidColorBrush x:Name="MenuIconBrush" Color="#1DB954"/>
                            </Path.Fill>
                            <Path.RenderTransform>
                                <RotateTransform x:Name="MenuIconRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                </Grid>

                <!-- 2. TAMPILAN EXPANDED (SAAT ISLAND BESAR) -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Info Lagu & Album Art Besar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art Besar: sudut melengkung, gambar dipotong dari tengah -->
                        <Grid Grid.Column="0" Width="65" Height="65">
                            <Border CornerRadius="14" Background="#222"/>
                            <Border CornerRadius="14">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AlbumArt, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Judul & Artis -->
                        <StackPanel x:Name="InfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                                    Style="{StaticResource InfoPanelStyle}">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" helpers:TextFit.MaxFontSize="{Binding InfoTitleFontSize}"
                                TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Artist}" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0"
                                helpers:TextFit.MaxFontSize="{Binding InfoArtistFontSize}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Lirik (menggantikan judul & artis saat tombol mic aktif) -->
                        <StackPanel x:Name="LyricsPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                                    Style="{StaticResource LyricsPanelStyle}">
                            <TextBlock Text="{Binding CurrentLyric}" Foreground="White" FontSize="14" FontWeight="Bold"
                                helpers:TextFit.MaxFontSize="{Binding LyricCurrentFontSize}"
                                TextWrapping="Wrap" MaxHeight="{Binding LyricMaxHeight}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding NextLyric}" Foreground="#777777" FontSize="11" Margin="0,3,0,0"
                                helpers:TextFit.MaxFontSize="{Binding LyricNextFontSize}"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tombol Kontrol Media (ikon hijau tanpa kotak) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE892;" Command="{Binding PrevCommand}" Margin="10,0"/>

                        <Button Style="{StaticResource IconButtonStyle}"
                            Content="{Binding PlayPauseGlyph}" FontSize="26"
                            Command="{Binding PlayPauseCommand}" Margin="10,0"/>

                        <Button Style="{StaticResource IconButtonStyle}"
                            Content="&#xE893;" Command="{Binding NextCommand}" Margin="10,0"/>

                        <Button Style="{StaticResource LyricsButtonStyle}"
                            Content="&#xE720;" Command="{Binding ToggleLyricsCommand}" Margin="10,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Pill kecil "Setting" di sebelah kiri island -->
        <Border x:Name="SettingsPill" Visibility="Collapsed" Opacity="0"
        Width="84" Height="36" CornerRadius="18" Background="#0F0F0F"
        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
        Cursor="Hand" RenderTransformOrigin="0.5,0.5"
        MouseLeftButtonDown="SettingsPill_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SettingsPillScale" ScaleX="0.5" ScaleY="0.5"/>
                    <TranslateTransform x:Name="SettingsPillTranslate" X="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#1DB954"
                   FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Setting" Foreground="White" FontSize="11" FontWeight="SemiBold"
                   Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Pill kecil "Keluar" di sebelah kanan island -->
        <Border x:Name="ExitPill" Visibility="Collapsed" Opacity="0"
        Width="84" Height="36" CornerRadius="18" Background="#0F0F0F"
        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
        Cursor="Hand" RenderTransformOrigin="0.5,0.5"
        MouseLeftButtonDown="ExitPill_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ExitPillScale" ScaleX="0.5" ScaleY="0.5"/>
                    <TranslateTransform x:Name="ExitPillTranslate" X="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5252"
                   FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Keluar" Foreground="White" FontSize="11" FontWeight="SemiBold"
                   Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Panel pengaturan: muncul di bawah island saat pill "Setting" diklik -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed" Opacity="0"
        Width="274" Background="#0F0F0F" CornerRadius="18" Padding="16,12"
        HorizontalAlignment="Center" VerticalAlignment="Top"
        Margin="0,63,94,0" RenderTransformOrigin="0.5,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="SettingsPanelScale" ScaleX="1" ScaleY="0.6"/>
            </Border.RenderTransform>

            <StackPanel>
                <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6">
            <Run Text="Font size: "/><Run Text="{Binding Settings.LyricFontSize, Mode=OneWay, StringFormat={}{0:0}}"/>
                </TextBlock>
                <Slider Minimum="12" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"
                Value="{Binding Settings.LyricFontSize}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
