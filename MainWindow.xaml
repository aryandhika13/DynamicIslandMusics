<Window x:Class="DynamicIslandDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island" 
        Height="200" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Style tombol ikon: tanpa kotak/border, hanya ikon hijau -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#1DB954"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" Padding="6"
                            RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Island Container -->
        <Border x:Name="IslandBorder" 
            Background="#0F0F0F" 
            CornerRadius="25" 
            Height="45" Width="48"
            HorizontalAlignment="Center" 
            VerticalAlignment="Top"
            Margin="0,10,0,0"
            MouseLeave="IslandBorder_MouseLeave">
            
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.5" Color="Black"/>
            </Border.Effect>

            <Grid x:Name="MainGrid" Margin="8,4">

                <!-- 1. TAMPILAN COMPACT (SAAT ISLAND KECIL) -->
                <Grid x:Name="CompactView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AlbumContainer" Grid.Column="0" Width="30" Height="30" Background="#222" CornerRadius="15" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="IntroScale" ScaleX="0.3" ScaleY="0.3"/>
                        </Border.RenderTransform>
                        <Image x:Name="CompactAlbumArt" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                            <Image.Clip>
                                <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15"/>
                            </Image.Clip>
                            <Image.RenderTransform>
                                <RotateTransform x:Name="AlbumRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>
                    </Border>

                    <!-- Area hover: hanya bagian tengah (judul/lirik) -->
                    <Border x:Name="HoverZone" Grid.Column="1" Background="Transparent"
                        MouseEnter="HoverZone_MouseEnter">
                                <TextBlock x:Name="CompactTitleText"
                               Text="Tidak ada media" Opacity="0"
                               Foreground="White" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="8,0"/>
                    </Border>

                    <!-- Ikon musik: bisa diklik, tidak memicu hover -->
                    <Border x:Name="MusicIconButton" Grid.Column="2" Background="Transparent" Cursor="Hand" Padding="4,0" MouseLeftButtonDown="MusicIcon_Click">
                        <TextBlock x:Name="CompactMusicIcon" Text="&#xE7E8;" Opacity="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#FF5252" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>    
                    </Border>
                </Grid>

                <!-- 2. TAMPILAN EXPANDED (SAAT ISLAND BESAR) -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Info Lagu & Album Art Besar -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Album Art Besar (Kotak Melengkung dengan CornerRadius="14") -->
                        <Border Grid.Column="0" CornerRadius="14" Width="65" Height="65" ClipToBounds="True" Background="#222">
                            <Image x:Name="ExpandedAlbumArt" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Judul & Artis -->
                        <StackPanel x:Name="InfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="TitleText" Text="Judul Lagu" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Text="Nama Artis" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Lirik (menggantikan judul & artis saat tombol mic aktif) -->
                        <StackPanel x:Name="LyricsPanel" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="LyricCurrent" Foreground="White" FontSize="14" FontWeight="Bold"
                                TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LyricNext" Foreground="#777777" FontSize="11" Margin="0,3,0,0"
                                TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Tombol Kontrol Media (ikon hijau tanpa kotak) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <!-- Previous -->
                        <Button x:Name="BtnPrev" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE892;" Click="BtnPrev_Click" Margin="10,0"/>

                        <!-- Play/Pause -->
                        <Button x:Name="BtnPlayPause" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE768;" FontSize="26" Click="BtnPlayPause_Click" Margin="10,0"/>

                        <!-- Next -->
                        <Button x:Name="BtnNext" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE893;" Click="BtnNext_Click" Margin="10,0"/>

                        <Button x:Name="BtnLyrics" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE720;" FontSize="18" Opacity="0.5"
                            Click="BtnLyrics_Click" Margin="10,0"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- Pill kecil "Keluar" di sebelah kanan island -->
        <Border x:Name="ExitPill" Visibility="Collapsed" Opacity="0"
        Width="84" Height="36" CornerRadius="18" Background="#0F0F0F"
        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
        Cursor="Hand" RenderTransformOrigin="0.5,0.5"
        MouseLeftButtonDown="ExitPill_Click">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ExitPillScale" ScaleX="0.5" ScaleY="0.5"/>
                    <TranslateTransform x:Name="ExitPillTranslate" X="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5252"
                   FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Keluar" Foreground="White" FontSize="11" FontWeight="SemiBold"
                   Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
